<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<div class="bg-grid"></div>

<%- include('partials/nav') %>

<main>

  <!-- ================= HERO ================= -->
  <section class="hero" id="top">
    <div class="hero__glow"></div>
    <div class="hero__grid">
      <div class="hero__text">
        <p class="hero__greeting"><%= profile.hero.greeting %></p>
        <h1 class="hero__name"><%= profile.hero.name %></h1>
        <p class="hero__role">I am a <span class="typewriter" id="typewriter"></span><span class="caret">|</span></p>
        <p class="hero__bio"><%= profile.hero.bio %></p>
        <a class="btn-primary" href="<%= profile.hero.cvFile %>" download>Download CV</a>
      </div>
      <div class="hero__photo-wrap">
        <div class="hero__photo-ring">
          <img src="<%= profile.hero.photo %>" alt="<%= profile.hero.name %>">
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section id="about">
    <h2 class="section-title">ABOUT</h2>
    <div class="section-underline"></div>
    <div class="about__body">
      <% profile.about.paragraphs.forEach(function(p) { %>
        <p><%- p %></p>
      <% }); %>
    </div>
  </section>

  <!-- ================= SKILLS ================= -->
  <section id="skills">
    <h2 class="section-title center">SKILLS</h2>
    <div class="section-underline center"></div>
    <p class="section-sub">A collection of my technical skills, sharpened through coursework and hands-on projects.</p>

    <div class="skills-grid">
      <% profile.skills.forEach(function(block) { %>
        <div class="skill-card">
          <h3><%= block.category %></h3>
          <div class="skill-card__items">
            <% block.items.forEach(function(item) { %>
              <span class="skill-pill"><span class="skill-pill__dot"><%= item.charAt(0) %></span><%= item %></span>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- ================= EXPERIENCE ================= -->
  <section id="experience">
    <h2 class="section-title center">EXPERIENCE</h2>
    <div class="section-underline center"></div>
    <p class="section-sub">Where I've applied what I've learned in a real working environment.</p>

    <div class="timeline">
      <% profile.experience.forEach(function(job, idx) { %>
        <div class="timeline__item <%= idx % 2 === 0 ? 'is-left' : 'is-right' %>">
          <div class="timeline__node"><%= job.logoText %></div>
          <div class="timeline__card">
            <h3><%= job.title %></h3>
            <p class="timeline__org"><%= job.org %></p>
            <p class="timeline__date"><%= job.date %></p>
            <p class="timeline__desc"><%= job.description %></p>
            <div class="timeline__tags">
              <% job.tags.forEach(function(t) { %><span><%= t %></span><% }); %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- ================= PROJECTS ================= -->
  <section id="projects">
    <h2 class="section-title center">PROJECTS</h2>
    <div class="section-underline center"></div>
    <p class="section-sub">A showcase of the projects I've worked on, highlighting my skills across different technologies.</p>

    <div class="projects-grid">
      <% profile.projects.forEach(function(proj) { %>
        <div class="project-card">
          <div class="project-card__thumb">
            <div class="project-card__thumb-glyph">&lt;/&gt;</div>
          </div>
          <div class="project-card__body">
            <h3><%= proj.title %></h3>
            <p class="project-card__sub"><%= proj.subtitle %></p>
            <p class="project-card__desc"><%= proj.description %></p>
            <div class="project-card__tags">
              <% proj.tags.forEach(function(t) { %><span><%= t %></span><% }); %>
            </div>
            <% if (proj.links && (proj.links.github || proj.links.live)) { %>
              <div class="project-card__links">
                <% if (proj.links.github) { %><a href="<%= proj.links.github %>" target="_blank" rel="noopener">Code</a><% } %>
                <% if (proj.links.live) { %><a href="<%= proj.links.live %>" target="_blank" rel="noopener">Live</a><% } %>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- ================= EDUCATION ================= -->
  <section id="education">
    <h2 class="section-title center">EDUCATION</h2>
    <div class="section-underline center"></div>
    <p class="section-sub">My academic path so far.</p>

    <div class="timeline">
      <% profile.education.forEach(function(ed, idx) { %>
        <div class="timeline__item <%= idx % 2 === 0 ? 'is-left' : 'is-right' %>">
          <div class="timeline__node"><%= ed.logoText %></div>
          <div class="timeline__card">
            <h3><%= ed.title %></h3>
            <p class="timeline__org"><%= ed.org %></p>
            <p class="timeline__date"><%= ed.date %></p>
            <% if (ed.grade) { %><p class="timeline__grade">Grade: <%= ed.grade %></p><% } %>
            <% if (ed.description) { %><p class="timeline__desc"><%= ed.description %></p><% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section id="contact">
    <h2 class="section-title center">CONTACT</h2>
    <div class="section-underline center"></div>
    <p class="section-sub">I'd love to hear from you — reach out for internships, projects or just to say hi.</p>

    <div class="contact-card">
      <h3>Connect With Me 🚀</h3>
      <form id="contactForm">
        <input type="email" placeholder="Your Email" required>
        <input type="text" placeholder="Your Name" required>
        <input type="text" placeholder="Subject">
        <textarea rows="5" placeholder="Message" required></textarea>
        <button type="submit" class="btn-gradient">Send</button>
      </form>
      <p class="contact-card__note">Prefer email directly? <a href="mailto:<%= profile.contact.email %>"><%= profile.contact.email %></a> · <a href="tel:<%= profile.contact.phoneHref %>"><%= profile.contact.phone %></a></p>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>

<script src="/js/main.js"></script>
<script>
  window.__PORTFOLIO_ROLES__ = <%- JSON.stringify(profile.hero.roles) %>;
</script>
</body>
</html>
